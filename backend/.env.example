# Copy this file to backend/.env. Leave the AI keys blank to run without AI (rule-based fallback).

# ---- AI agents: fill in ONE key. The provider is auto-detected from the key.
# LLM_PROVIDER=groq        # groq | gemini | openai | anthropic (only if you have several keys)
# LLM_MODEL=               # optional: override the default model id
# LLM_TIMEOUT_SECONDS=45
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Modelling
# TUNING_BUDGET_SECONDS=45   # 0 switches hyperparameter tuning off

# ---- Accounts and limits (the defaults are fine for local use)
# ENV=production             # requires SECRET_KEY
# SECRET_KEY=
# ALLOWED_ORIGINS=http://localhost:3000
# ALLOW_REGISTRATION=true
# MAX_RUNS_PER_DAY=30
# TOKEN_DAYS=7
# AUTH_COOKIE_SAMESITE=none    # production cross-site deployment; use lax locally

# ---- Storage
# DATABASE_URL=sqlite:///data/app.db     # or a Postgres URL (also: pip install "psycopg[binary]")
# DATA_DIR=data
# ARTIFACT_STORAGE=local      # local | s3
# ARTIFACT_BUCKET=            # required for S3-compatible storage
# AWS_REGION=                 # standard AWS SDK credentials/role chain is used
# S3_ENDPOINT_URL=            # optional, for S3-compatible services

# ---- Email verification (production requires working SMTP)
# FRONTEND_URL=http://localhost:3000
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_STARTTLS=true
# VERIFY_TOKEN_HOURS=24
