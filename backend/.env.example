# Copy this file to backend/.env and fill in ONE key. Leave all blank to run without AI (rule-based fallback).
# Provider is auto-detected from the key. Set LLM_PROVIDER only if you have several keys.
# LLM_PROVIDER=groq        # groq | gemini | openai | anthropic
# LLM_MODEL=               # optional: override the default model id
# LLM_TIMEOUT_SECONDS=45

GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
